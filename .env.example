# Supabase project (URL + anon/publishable key) — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic API key — enables full AI answer generation.
# Leave empty to run in demo mode (bot answers with relevant document passages, no LLM).
ANTHROPIC_API_KEY=

# OR: any OpenAI-compatible server (Ollama, OpenWebUI, vLLM, LM Studio…).
# Used when ANTHROPIC_API_KEY is empty. Example: http://localhost:11434/v1
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=

# Base URL of the app (used in widget embed snippets)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: public_id of a bot to show as the live demo widget on the landing page
NEXT_PUBLIC_DEMO_BOT_ID=
